# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. (.env는 git에 올라가지 않습니다)
# Flow 관리자 계정 > API Key 관리 페이지에서 발급한 키 (보통 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx 형태)
FLOW_API_KEY=
# 게시글 작성자 ID (Flow 로그인 ID, 이메일 형태). 게시할 때만 필요
FLOW_REGISTER_ID=
# 선택: 기본값 충무타올
# FLOW_PROJECT_NAME=충무타올
# 선택: 기본값 https://api.flow.team
# FLOW_API_BASE=https://api.flow.team
